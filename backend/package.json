{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "lint": "eslint src scripts --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "seed:demo:reset": "tsx --env-file=.env scripts/reset-demo.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "geotiff": "^2.1.3",
    "helmet": "^8.1.0",
    "jose": "^6.0.10",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^8.13.2",
    "pdfkit": "^0.17.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pngjs": "^7.0.0",
    "proj4": "^2.15.0",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pngjs": "^6.0.5",
    "@types/proj4": "^2.5.6",
    "@types/supertest": "^6.0.3",
    "@types/svg-to-pdfkit": "^0.1.3",
    "eslint": "^9.24.0",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
