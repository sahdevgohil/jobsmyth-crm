NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/legacy-roofing-crm?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
REFRESH_TOKEN_TTL_DAYS=14
# Shared secret for POST /api/v1/public/website-leads (header X-Website-Lead-Secret)
WEBSITE_LEAD_INTAKE_SECRET=change-me-website-intake-secret-16+
# Local dev file storage (S3 is not configured). Files are only served via the authenticated API.
FILE_STORAGE_DIR=./storage
FILE_MAX_BYTES=8000000

# Local dev only (ignored in production)
# AUTH_RATE_LIMIT_MAX=1000

# Google Cloud API key for Solar API + Geocoding API (server-side only; restrict it to these two APIs and your server IP).
# GOOGLE_SOLAR_API_KEY=
